{
  "appId": "com.libya.quran",
  "appName": "مصحف ليبيا",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": true,
      "updateUrl": "https://github.com/abdo15542/libya-quran-app/releases/latest/download/update.json",
      "resetWhenUpdate": false,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "responseTimeout": 30,
      "allowModifyUrl": true,
      "statsUrl": ""
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#0a3d2c"
    }
  }
}
