{
  "appId": "com.libya.quran",
  "appName": "مصحف ليبيا",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 30000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "responseTimeout": 30,
      "statsUrl": ""
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#0a3d2c"
    }
  }
}
